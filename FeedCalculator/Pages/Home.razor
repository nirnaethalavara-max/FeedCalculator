@page "/"

<div class="container mt-4" style="max-width: 480px;">
    <div class="card shadow-sm p-4">
        <div class="alert alert-success text-center mb-4">
            <div class="small text-uppercase fw-bold">Патрэба статку ў кармавых адзінках на</div>
            <input type="number" min="1" max="99999" inputmode="numeric" placeholder="1"
                   class="form-control form-control-lg text-center"
                   value="@calculator.Days"
                   @oninput="OnDaysInput" />
            <div class="small text-uppercase fw-bold">
                @GetDaysWord(calculator.Days)
            </div>
            
        </div>


        <div>
            <label>Цяляты (0–8 мес.): </label>
            <input type="number" min="0" max="99999" inputmode="numeric" placeholder="0"
                   class="form-control form-control-lg text-center"
                   value="@calculator.Calves0To8"
                   @oninput="OnCalves0To8Input" />

        </div>

        <div>
            <label>Цяляты (9–15 мес.): </label>
            <input type="number" min="0" max="99999" inputmode="numeric" placeholder="0"
                   class="form-control form-control-lg text-center"
                   value="@calculator.Calves9To15"
                   @oninput="OnCalves9To15Input" />
        </div>

        <div>
            <label>Ялавыя і сьцельныя (да 6 мес.) каровы: </label>
            <input type="number" min="0" max="99999" inputmode="numeric" placeholder="0"
                   class="form-control form-control-lg text-center"
                   value="@calculator.DryCows"
                   @oninput="OnDryCowsInput" />
        </div>

        <div>
            <label>Сьцельныя (7-9 мес.) каровы: </label>
            <input type="number" min="0" max="99999" inputmode="numeric" placeholder="0"
                   class="form-control form-control-lg text-center"
                   value="@calculator.PregnantCows"
                   @oninput="OnPregnantCowsInput" />
        </div>

        <div>
            <label>Быкі: </label>
            <input type="number" min="0" max="99999" inputmode="numeric" placeholder="0"
                   class="form-control form-control-lg text-center"
                   value="@calculator.MaleCows"
                   @oninput="OnMaleCowsInput" />
        </div>

        <div class="alert alert-success text-center mt-4 mb-4">
            <div class="display-5 fw-bold">@calculator.Calculate().ToString("F1")</div>
            <div>кармавых адзінак</div>
        </div>

        <button type="button" class="btn btn-outline-danger btn-lg w-100 mt-2" @onclick="calculator.Reset">Ачысціць</button>
               
    </div>
</div>



@code {
    private FeedCalculatorModel calculator = new FeedCalculatorModel();
    private void OnCalves0To8Input(ChangeEventArgs e)
    {
        calculator.Calves0To8 = FilterInput(e.Value?.ToString(), calculator.Calves0To8);
    }
    private void OnCalves9To15Input(ChangeEventArgs e)
    {
        calculator.Calves9To15 = FilterInput(e.Value?.ToString(), calculator.Calves9To15);
    }
    private void OnDryCowsInput(ChangeEventArgs e)
    {
        calculator.DryCows = FilterInput(e.Value?.ToString(), calculator.DryCows);
    }
    private void OnPregnantCowsInput(ChangeEventArgs e)
    {
        calculator.PregnantCows = FilterInput(e.Value?.ToString(), calculator.PregnantCows);
    }
    private void OnMaleCowsInput(ChangeEventArgs e)
    {
        calculator.MaleCows = FilterInput(e.Value?.ToString(), calculator.MaleCows);
    }
    private void OnDaysInput(ChangeEventArgs e)
    {
        calculator.Days = FilterInput(e.Value?.ToString(), calculator.Days);
    }
    private int? FilterInput(string? rawText, int? previousValue)
    {
        if (string.IsNullOrWhiteSpace(rawText))
            return null;

        if (int.TryParse(rawText, out int number) && number >= 0 && number <= 99999)
            return number;

        return previousValue;
    }
    private string GetDaysWord(int? days)
    {
        int value = days ?? 1; // Калі поле пустое (null), выкарыстоўваецца 1 (верне "дзень")

        int lastTwo = value % 100;
        if (lastTwo >= 11 && lastTwo <= 14)
        {
            return "дзён";
        }

        return (value % 10) switch
        {
            1 => "дзень",
            2 or 3 or 4 => "дні",
            _ => "дзён"
        };
    }


}
